<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#E6202124">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Presidente · 2º turno" android:textColor="#B0B0B0" android:textSize="11sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/n0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/p0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/v0" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#B0B0B0" android:textSize="11sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/p1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/v1" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#B0B0B0" android:textSize="11sp"/>
    <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
        android:max="1000" android:progressTint="#2E7D32" android:progressBackgroundTint="#757575"/>
    <TextView android:id="@+id/st" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#B0B0B0" android:textSize="10sp"/>
</LinearLayout>
